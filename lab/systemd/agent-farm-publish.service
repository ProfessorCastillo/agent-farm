[Unit]
Description=Agent Farm validated website publisher
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=adminvince
Group=adminvince
WorkingDirectory=/home/adminvince/projects/agent_farm
ExecStart=/home/adminvince/projects/agent_farm/.venv/bin/python -m agent_lab.cli --config /home/adminvince/projects/agent_farm/lab/config.toml publish
Environment=PYTHONPATH=/home/adminvince/projects/agent_farm
Environment=PLAYWRIGHT_BROWSERS_PATH=/home/adminvince/projects/agent_farm/.runtime/playwright
Environment=PATH=/home/adminvince/projects/agent_farm/.runtime/node/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/adminvince/projects/agent_farm/.venv
BindReadOnlyPaths=/home/adminvince/projects/agent_farm/.runtime
BindReadOnlyPaths=/home/adminvince/projects/agent_farm/agent_lab
BindReadOnlyPaths=/home/adminvince/projects/agent_farm/lab
BindReadOnlyPaths=/home/adminvince/projects/agent_farm/.secrets
BindPaths=/home/adminvince/projects/agent_farm/.lab-state
ReadWritePaths=/home/adminvince/projects/agent_farm/.lab-state
ReadOnlyPaths=/home/adminvince/projects/agent_farm/.secrets
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
MemoryMax=4G
CPUQuota=200%
Nice=10
IOSchedulingClass=idle
TasksMax=256
TimeoutStartSec=10min
TimeoutStopSec=20s
KillMode=mixed
Restart=on-failure
RestartSec=5min
